# ---------------------------------------------------------------------------
# PERSONAL DATA — never commit. These are not "build noise"; under DPDP 2023
# facial features, pose and pulse are personal data, and a consent record
# identifies a subject. A repository is not a lawful place to retain either,
# and git history makes deletion-on-withdrawal effectively impossible.
# ---------------------------------------------------------------------------
out/*.parquet
out/*.config.json
out/consent.json
out/consent*.json
out/sessions/
out/subjects/
out/audit/
out/withdrawals/
out/interviews/
*.parquet

# Raw video and audio. The programme's recorded decision is to extract
# features and discard footage — this keeps an accident from contradicting it.
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.m4a

# ---------------------------------------------------------------------------
# Secrets. A committed API key is a key that has to be rotated, and git
# history makes removing it a rewrite rather than a deletion. `.env.example`
# is tracked deliberately -- it holds placeholders and documents the names.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Local artefacts
# ---------------------------------------------------------------------------
models/*.part

# Third-party research checkpoints, fetched by fetch_compare_models.py.
# Not vendored: these come from rPPG-Toolbox and are trained on PURE and
# UBFC-rPPG, datasets with their own usage agreements. Redistributing weights
# derived from them through this repo is not ours to do. The MediaPipe weights
# in models/ ARE committed -- Apache-2.0, intended for redistribution.
vendor/

.DS_Store
*.swp
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Deliberately NOT ignored:
#   models/*.task          vendored weights, pinned by digest in
#                          signals/models.py — committing them is the point
#   out/parameters.csv     generated parameter catalogue, no personal data
#   out/interview-parameters.xlsx
# ---------------------------------------------------------------------------
models/face_recognition_sface.onnx

# Cached per-patch RGB traces from recordings. Large, binary, and entirely
# regenerable with `python3 rppg_traces.py <clip>` -- but derived from a
# person's face, so it is not committed either.
out/rppg-traces/
# Reference-pulse labels. Physiological data about a named person, swept by
# consent withdrawal (consent.SATELLITE_STORES). Never committed.
out/rppg-truth/
out/rppg-tuning*.log
out/rppg-tuning-report.json
out/rppg-real-stats.json
